{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZGym",
  "version": "0.1.1",
  "identifier": "com.zomet.zgym.desktop",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "security": {
      "csp": null
    },
    "withGlobalTauri": true
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
